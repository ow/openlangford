          "native_text_sha256": "ea3e71ff33906227bfb554028e2d52ec58d13c6e2870c127d1d39a5769ca6992",
          "render_sha256": "05a2d04e674a795500b7ac467a957ffbcd518ee6b0d542e596efe8c8f64f51ce"
        }
      ],
      "independent_review_sha256": "07a7a0d9522bbe1f95edfe0c56e3cde3d6ea7b8d08b6f6f06b4d9e6b00362a27",
      "authority": "operative_body_and_result_only",
