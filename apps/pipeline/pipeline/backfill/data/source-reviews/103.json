    },
    {
      "source_key": "b39c7c907dbfb285745b9940e5849cea0b7d3856dec92a9becca865d73449e1a",
      "raw_block_sha256": "2c6ce3ebefb9e926ed298f999c64d4a5a3c4be6db074ed1f0d1fad0129c88298",
      "operative_body": "That Council: 1. Endorse the following three priorities for transportation in importance order as follows: a. Installation of High Occupancy Vehicle Lanes (HOV)/bus lanes on the Trans Canada Highway between the West Shore Parkway and downtown Victoria; b. Development of the E&N Corridor by BC Transit for a major bus or train corridor; and c. Upgrades to Sooke Road Highway No. 14 leading to and from the municipality of Sooke And 2. That, to further advance these priorities and to reduce duplication of services, the City write a letter to the Capital Regional District suggesting that an advisory committee be established to provide recommendations and priorities to BC Transit and the Ministry of Transportation and Infrastructure; AND 3. That the three priority areas and request for a CRD advisory committee be forwarded to the Minister of Transportation and Infrastructure and to BC Transit for information.",
      "operative_body_sha256": "4e468433ec53ed0edcc6c1383a281ca7276d128ee64b02149ff1bf3b6e4927eb",
      "result": "CARRIED",
