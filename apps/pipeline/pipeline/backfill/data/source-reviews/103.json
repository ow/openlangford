    {
      "source_key": "ffea7f52bc97fefe5b1468ae2e9e318362849f2fa3f1aa4fa63ecc257c6d6143",
      "raw_block_sha256": "e417602ecc20624c07e736799db5fce94eb2af51695d1eaa424d0b2adad0bcc3",
      "operative_body": "That Council: 1. Give First Reading to Bylaw No. 1717; and 2. Add to the Council Resolution of September 5, 2017 by adding the following requirement to the Section 219 Covenant to be registered prior to Bylaw Adoption: vi. That public road access and servicing to Bylaw No. 1000 standards, or some other legal mechanism accomplishing the same purposes for access and servicing, be extended through the subject property to the boundary of the property legally described as Lot A, Section 1, Range 4 West, Highland District, Plan EPP40953 (See Plan as to Limited Access), to the satisfaction of the Director of Engineering and the Approving Officer, prior to the issuance of a Building Permit or Subdivision Approval, whoever occurs first.",
      "operative_body_sha256": "52ba28955d88f1bc1c6a1518c97d586df144c1df9324d94ebc08c35838fde7b0",
      "result": "CARRIED",
      "pages": [
